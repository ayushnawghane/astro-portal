# Local Postgres. If you're using `npx prisma dev`, run it once and copy the
# connection string it prints (port varies per machine) — see backend README.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/astro_portal?schema=public"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000
