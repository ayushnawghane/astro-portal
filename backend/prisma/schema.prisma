// Astro Portal — Phase 1 (trimmed MVP) data model
// Covers: user management/profiles, horoscope, panchang, free kundli,
// astrologer marketplace, consultation (chat) + wallet, reviews.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ASTROLOGER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ProfileRelation {
  SELF
  SPOUSE
  CHILD
  PARENT
  CUSTOM
}

enum AstrologerBadge {
  NEW
  VERIFIED
  EXPERT
  CELEBRITY
}

enum OnboardingStage {
  APPLICATION_SUBMITTED
  SCREENING
  PROBATION
  ACTIVE
}

enum ConsultationType {
  CHAT
  VOICE
}

enum ConsultationStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WalletTxnType {
  RECHARGE
  DEBIT
  REFUND
  PROMOTION
}

enum HoroscopeType {
  YESTERDAY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  phone           String?  @unique
  passwordHash    String?
  role            UserRole @default(USER)
  isEmailVerified Boolean  @default(false)
  isPhoneVerified Boolean  @default(false)
  hasUsedFreeChat Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profiles      Profile[]
  wallet        Wallet?
  astrologer    Astrologer?
  consultations Consultation[]
  reviews       Review[]
  otpCodes      OtpCode[]

  @@index([role])
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  target     String // email or phone the OTP was sent to
  codeHash   String
  purpose    String // REGISTER | LOGIN | PASSWORD_RESET
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, purpose])
}

model Profile {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  relation     ProfileRelation @default(SELF)
  name         String
  gender       Gender
  dateOfBirth  DateTime
  timeOfBirth  String // stored as HH:mm (24h)
  placeOfBirth String
  latitude     Float?
  longitude    Float?
  timezone     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  kundliReports KundliReport[]

  @@index([userId])
}

model KundliReport {
  id                 String   @id @default(cuid())
  profileId          String
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  chartData          Json
  planetaryPositions Json
  houseAnalysis      Json?
  dashaInfo          Json?
  doshas             Json?
  yogas              Json?
  pdfUrl             String?
  createdAt          DateTime @default(now())

  @@index([profileId])
}

model Astrologer {
  id                  String          @id @default(cuid())
  userId              String          @unique
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String
  bio                 String?
  experienceYears     Int             @default(0)
  languages           String[]
  expertise           String[]
  pricePerMinuteChat  Decimal         @db.Decimal(10, 2)
  pricePerMinuteVoice Decimal?        @db.Decimal(10, 2)
  badge               AstrologerBadge @default(NEW)
  onboardingStage     OnboardingStage @default(APPLICATION_SUBMITTED)
  isApproved          Boolean         @default(false)
  isAvailable         Boolean         @default(false)
  ratingAvg           Float           @default(0)
  ratingCount         Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  consultations Consultation[]
  reviews       Review[]

  @@index([isApproved, isAvailable])
  @@index([badge])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0) @db.Decimal(10, 2)
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String        @id @default(cuid())
  walletId    String
  wallet      Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        WalletTxnType
  amount      Decimal       @db.Decimal(10, 2)
  description String?
  createdAt   DateTime      @default(now())

  @@index([walletId])
}

model Consultation {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  astrologerId    String
  astrologer      Astrologer         @relation(fields: [astrologerId], references: [id])
  type            ConsultationType   @default(CHAT)
  status          ConsultationStatus @default(PENDING)
  isFreeSession   Boolean            @default(false)
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  amountCharged   Decimal?           @db.Decimal(10, 2)
  createdAt       DateTime           @default(now())

  messages ChatMessage[]
  review   Review?

  @@index([userId])
  @@index([astrologerId])
  @@index([status])
}

model ChatMessage {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  attachmentUrl  String?
  createdAt      DateTime     @default(now())

  @@index([consultationId])
}

model Review {
  id             String       @id @default(cuid())
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  astrologerId   String
  astrologer     Astrologer   @relation(fields: [astrologerId], references: [id])
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now())

  @@index([astrologerId])
}

model Horoscope {
  id             String        @id @default(cuid())
  zodiacSign     String
  type           HoroscopeType
  date           DateTime      @db.Date
  content        String
  luckyColor     String?
  luckyNumber    String?
  luckyTime      String?
  luckyDirection String?
  luckyGemstone  String?
  createdAt      DateTime      @default(now())

  @@unique([zodiacSign, type, date])
  @@index([type, date])
}

model Panchang {
  id         String    @id @default(cuid())
  date       DateTime  @db.Date
  location   String
  latitude   Float
  longitude  Float
  tithi      String
  nakshatra  String
  yoga       String
  karana     String
  sunrise    DateTime
  sunset     DateTime
  moonrise   DateTime?
  moonset    DateTime?
  rahuKaal   String
  gulikaKaal String
  yamaganda  String
  createdAt  DateTime  @default(now())

  @@unique([date, location])
}

model ShubhMuhurat {
  id           String   @id @default(cuid())
  activityType String // e.g. "marriage", "griha-pravesh", "vehicle-purchase", "naming-ceremony", "business-opening"
  date         DateTime @db.Date
  title        String
  description  String
  timings      Json // [{ start: "10:00", end: "11:30", quality: "Best" }, ...]
  createdAt    DateTime @default(now())

  @@unique([activityType, date])
  @@index([activityType, date])
}

enum ContentCategory {
  BLOG
  EDUCATION
}

model Content {
  id            String          @id @default(cuid())
  category      ContentCategory
  slug          String          @unique
  title         String
  summary       String
  body          String
  tags          String[]
  coverImageUrl String?
  isPublished   Boolean         @default(false)
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([category, isPublished, publishedAt])
}
